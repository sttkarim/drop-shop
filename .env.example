# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# Telegram ID администраторов через запятую
ADMIN_IDS=111111111

# Публичный HTTPS-адрес Mini App (для кнопки в боте).
# Локально — туннель, например: WEBAPP_URL=https://xxxx.trycloudflare.com
WEBAPP_URL=

# Путь к базе данных (необязательно)
DB_PATH=data/shop.db

# Директория для загруженных фото (необязательно)
UPLOADS_DIR=static/uploads

# Товаров на странице каталога (необязательно)
ITEMS_PER_PAGE=24

# Прокси для доступа к Telegram (необязательно): socks5://user:pass@127.0.0.1:1080
PROXY_URL=

# Домен для Docker-развёртывания (Caddy сам выпустит HTTPS-сертификат).
# Например: DOMAIN=shop.example.com
DOMAIN=
